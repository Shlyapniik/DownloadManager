<Window x:Class="DownloadManager.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Width="1000"
        Height="700"
        MinWidth="800"
        MinHeight="500"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->

        <TextBlock Grid.Row="0"
                   Text="Download Manager"
                   FontSize="28"
                   FontWeight="SemiBold"/>

        <!-- Добавление загрузки -->

        <Grid Grid.Row="2">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="120"/>
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0"
                     Height="35"
                     Margin="0,0,10,0"
                     VerticalContentAlignment="Center"
                     FontSize="14"
                     Text="{Binding DownloadUrl, UpdateSourceTrigger=PropertyChanged}"/>

            <Button Grid.Column="1"
                    Height="35"
                    Content="Download"
                    Command="{Binding AddDownloadCommand}"/>

        </Grid>

        <!-- Список загрузок -->

        <Border Grid.Row="4"
                BorderBrush="LightGray"
                BorderThickness="1"
                CornerRadius="5">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Заголовок списка -->

                <Border Grid.Row="0"
                        Background="#EEEEEE"
                        Padding="15">

                    <TextBlock Text="Downloads"
                               FontSize="18"
                               FontWeight="SemiBold"/>

                </Border>

                <!-- Элементы загрузок -->

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto">

                    <ItemsControl ItemsSource="{Binding Downloads}">

                        <ItemsControl.ItemTemplate>

                            <DataTemplate>

                                <Border Margin="10"
                                        Padding="15"
                                        BorderBrush="#DDDDDD"
                                        BorderThickness="1"
                                        CornerRadius="5">

                                    <Grid>

                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Имя файла -->

                                        <TextBlock Grid.Row="0"
                                                   Text="{Binding FileName}"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"/>

                                        <!-- URL -->

                                        <TextBlock Grid.Row="1"
                                                   Margin="0,5,0,10"
                                                   Text="{Binding Url}"
                                                   Foreground="Gray"
                                                   TextTrimming="CharacterEllipsis"/>

                                        <!-- Прогресс -->

                                        <ProgressBar Grid.Row="2"
                                                     Height="20"
                                                     Minimum="0"
                                                     Maximum="100"
                                                     Value="{Binding Progress}"/>

                                        <!-- Информация и кнопки -->

                                        <Grid Grid.Row="3"
                                              Margin="0,8,0,0">

                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Статус -->

                                            <TextBlock Grid.Row="0"
                                                       Text="{Binding StatusText}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,0,0,8"/>

                                            <!-- Информация и управление -->

                                            <Grid Grid.Row="1">

                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Прогресс и скорость -->

                                                <StackPanel Grid.Column="0"
                                                            Orientation="Horizontal">

                                                    <TextBlock Text="{Binding Progress, StringFormat={}{0:F1}%}"/>

                                                    <TextBlock Margin="15,0,0,0"
                                                               Text="{Binding DownloadedSizeText}"/>

                                                    <TextBlock Margin="5,0,0,0"
                                                               Text="/"/>

                                                    <TextBlock Margin="5,0,0,0"
                                                               Text="{Binding TotalSizeText}"/>

                                                    <TextBlock Margin="15,0,0,0"
                                                               Text="{Binding SpeedText}"/>

                                                    <TextBlock Margin="15,0,0,0"
                                                               Text="{Binding RemainingTimeText}"/>

                                                </StackPanel>

                                                <!-- Управление загрузкой -->

                                                <StackPanel Grid.Column="2"
                                                            Margin="15,0,0,0"
                                                            Orientation="Horizontal">

                                                    <Button Padding="12,5"
                                                            Content="Pause"
                                                            Command="{Binding DataContext.PauseDownloadCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"/>

                                                    <Button Margin="5,0,0,0"
                                                            Padding="12,5"
                                                            Content="Resume"
                                                            Command="{Binding DataContext.ResumeDownloadCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"/>

                                                    <Button Margin="5,0,0,0"
                                                            Padding="12,5"
                                                            Content="Cancel"
                                                            Command="{Binding DataContext.CancelDownloadCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"/>

                                                    <Button Margin="5,0,0,0"
                                                            Padding="12,5"
                                                            Content="Retry"
                                                            Command="{Binding DataContext.RetryDownloadCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"/>

                                                    <Button
                                                            Content="Delete"
                                                            Command="{Binding DataContext.DeleteDownloadCommand,RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Margin="5,0,0,0"/>

                                                </StackPanel>

                                            </Grid>

                                        </Grid>

                                    </Grid>

                                </Border>

                            </DataTemplate>

                        </ItemsControl.ItemTemplate>

                    </ItemsControl>

                </ScrollViewer>

            </Grid>

        </Border>

    </Grid>

</Window>
